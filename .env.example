# Copy to .env (loaded by Next.js, Prisma, and the MCP entrypoint).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Runtime: Supabase transaction pooler connection (port 6543).
DATABASE_URL=postgresql://postgres.your-project:password@your-pooler-host:6543/postgres?sslmode=require
# Migrations/Studio: direct connection, or session pooler (port 5432) for IPv4.
DIRECT_URL=postgresql://postgres.your-project:password@your-pooler-host:5432/postgres?sslmode=require

# Server-side only. Get these from the Sinch dashboard's Access keys page.
SINCH_PROJECT_ID=
SINCH_KEY_ID=
SINCH_KEY_SECRET=
SINCH_APP_ID=
SINCH_REGION=us
# Optional fallback for SMS callbacks without sender_id. Use your Sinch number.
# Replies normally use the receiving number from the signed inbound callback.
SINCH_SMS_SENDER=
# Must match the secret configured on the MESSAGE_INBOUND webhook.
SINCH_WEBHOOK_SECRET=

# Backend/admin access to POST /api/mcp. This grants access to every saved sender.
MCP_BEARER_TOKEN=

# Server-side only. Used by the church agent after a verified Sinch callback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
